{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}